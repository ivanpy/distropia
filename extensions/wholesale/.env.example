# Wholesale extension environment variables.
# Copy needed keys into the root .env.
# Never commit real values.
# Core DB variables (DB_*) come from EverShop core.

# --- Storefront ---
# Base URL for links (e.g. WhatsApp mock-action links)
SHOP_URL=http://localhost:3000

# --- WhatsApp Cloud API ---
# true = log messages to console and enable
# GET /api/wholesale/mock-action (ignored in production)
WHATSAPP_MOCK_ENABLED=true
WHATSAPP_GRAPH_API_VERSION=v21.0
# Production: permanent System User token, not the 24h one
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta App Secret; verifies X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# Random string set in the Meta webhook settings
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=presupuesto_mayorista_v1
WHATSAPP_TEMPLATE_LANG=es

# --- Bot protection (Cloudflare Turnstile) ---
# Site key is public; secret never reaches client or logs.
# Dev/e2e test keys (always pass):
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=shop.example.com
